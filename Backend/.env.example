# Copy this file to .env and fill in your own values.

# Gemini API key from Google AI Studio. Either variable name is accepted.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Current Gemini model. Change only if your account has access to another model.
ADK_MODEL=gemini-3.5-flash-lite

# Optional: GitHub Personal Access Token.
# You can also paste a token when connecting a repository in the UI.
GITHUB_TOKEN=

DATABASE_URL=sqlite:///./docdrift.db
CHROMA_DIR=./chroma_store
FRONTEND_ORIGIN=http://localhost:5173
